# Instantly API v2 Key (from https://app.instantly.ai/app/settings/integrations)
# Minimum 32 characters
INSTANTLY_API_KEY=your_instantly_api_key_must_be_at_least_32_characters_long

# Role tokens for MCP clients (minimum 32 characters each)
VIEWER_TOKEN=viewer_token_secret_value_at_least_32_characters_long
OPERATOR_TOKEN=operator_token_secret_value_at_least_32_characters_long
ADMIN_TOKEN=admin_token_secret_value_at_least_32_characters_long

# Allowed CORS / Origin header values (comma-separated, no wildcards allowed)
# Leave empty or set specific origins like https://my-client.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Security flag: allow destructive admin tools (e.g. activate_campaign)
ENABLE_ADMIN_TOOLS=false

# Mock mode: returns realistic fake data from Instantly API client without calling live API
MOCK_MODE=false

# Server port (Render will override via PORT env var)
PORT=3000

# Log level: silent | trace | debug | info | warn | error | fatal
LOG_LEVEL=info
