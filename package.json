{
  "name": "instantly-mcp-server",
  "version": "1.0.0",
  "description": "Production-quality remote MCP server for Instantly.ai API v2",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
